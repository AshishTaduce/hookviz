{
  "meta": {
    "schemaVersion": 2,
    "id": "usetransition-tab-switch",
    "title": "useTransition — marking an update low priority",
    "hook": "useTransition",
    "category": "usetransition",
    "reactVersion": "19.2.8",
    "source": "// @title useTransition — marking an update low priority\n// @hook useTransition\nimport { useState, useTransition } from 'react';\n\nexport default function TabSwitcher() {\n  const [tab, setTab] = useState('home');\n  // @annotate:comment Concurrent hook | isPending tells you a transition is still in flight; startTransition is the scheduling handle.\n  const [isPending, startTransition] = useTransition();\n\n  // @note startTransition marks the update inside it as low priority — React can interrupt or defer it for more urgent work.\n  const selectTab = (next: string) => {\n    startTransition(() => {\n      setTab(next);\n    });\n  };\n\n  return (\n    <div>\n      <span id=\"tab\">{isPending ? 'pending' : tab}</span>\n      <button id=\"about\" onClick={() => selectTab('about')}>\n        about\n      </button>\n    </div>\n  );\n}\n\nexport const scenario = async ({ click }: { click: (s: string) => void }) => {\n  click('#about');\n};\n",
    "annotations": [
      {
        "line": 8,
        "type": "comment",
        "label": "Concurrent hook",
        "detail": "isPending tells you a transition is still in flight; startTransition is the scheduling handle."
      }
    ],
    "recordedAt": "2026-08-19T12:58:53.943Z"
  },
